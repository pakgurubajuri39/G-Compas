rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /test_results/{resultId} {
      allow read: if true;
      allow create: if isValidId(resultId) && request.resource.data.fullName is string;
      allow update, delete: if isValidId(resultId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
